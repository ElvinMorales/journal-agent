{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/memory-update-proposal.schema.json",
  "title": "Memory Update Proposal",
  "description": "A reviewable durable-memory candidate. This artifact is proposal-only and never authorizes or performs a Memory write.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "proposal_type",
    "destination",
    "status",
    "proposed_durable_text",
    "reason_it_may_remain_useful",
    "evidence_summary",
    "uncertainty_or_counterevidence",
    "source_reference",
    "review_decision",
    "reviewer_notes",
    "edited_approved_text",
    "created_at",
    "updated_at",
    "reviewed_at",
    "safety_privacy_checks",
    "proposal_only",
    "human_review_required",
    "review_reminder"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "pattern": "^memory-proposal-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "proposal_type": { "const": "memory" },
    "destination": { "const": "private_memory" },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "edited", "discarded"]
    },
    "proposed_durable_text": {
      "type": "string",
      "minLength": 1,
      "description": "The exact minimal wording proposed for durable Memory; never raw journal text or an excerpt."
    },
    "reason_it_may_remain_useful": { "type": "string", "minLength": 1 },
    "evidence_summary": {
      "type": "string",
      "minLength": 1,
      "description": "A synthetic, minimal, or redacted summary. Do not copy raw journal content or selected excerpts."
    },
    "uncertainty_or_counterevidence": { "type": "string", "minLength": 1 },
    "source_reference": { "$ref": "#/$defs/source_reference" },
    "review_decision": {
      "type": "string",
      "enum": ["pending", "approved", "edited", "discarded"]
    },
    "reviewer_notes": { "type": ["string", "null"] },
    "edited_approved_text": {
      "type": ["string", "null"],
      "description": "The exact user-approved replacement wording when status is edited; otherwise null."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "safety_privacy_checks": { "$ref": "#/$defs/safety_privacy_checks" },
    "proposal_only": { "const": true },
    "human_review_required": { "const": true },
    "review_reminder": {
      "const": "Proposal only: a human must approve the exact wording and private Memory destination before manually copying any update."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pending" } }, "required": ["status"] },
      "then": {
        "properties": {
          "review_decision": { "const": "pending" },
          "reviewed_at": { "type": "null" },
          "edited_approved_text": { "type": "null" },
          "safety_privacy_checks": {
            "properties": { "exact_wording_and_destination_approved": { "const": false } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
      "then": {
        "properties": {
          "review_decision": { "const": "approved" },
          "reviewed_at": { "type": "string" },
          "edited_approved_text": { "type": "null" },
          "safety_privacy_checks": { "$ref": "#/$defs/approved_safety_privacy_checks" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "edited" } }, "required": ["status"] },
      "then": {
        "properties": {
          "review_decision": { "const": "edited" },
          "reviewed_at": { "type": "string" },
          "edited_approved_text": { "type": "string", "minLength": 1 },
          "safety_privacy_checks": { "$ref": "#/$defs/approved_safety_privacy_checks" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "discarded" } }, "required": ["status"] },
      "then": {
        "properties": {
          "review_decision": { "const": "discarded" },
          "reviewed_at": { "type": "string" },
          "edited_approved_text": { "type": "null" },
          "safety_privacy_checks": {
            "properties": { "exact_wording_and_destination_approved": { "const": false } }
          }
        }
      }
    }
  ],
  "$defs": {
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_session_id"],
      "properties": {
        "private_session_id": {
          "type": "string",
          "pattern": "^session-[a-z0-9][a-z0-9-]{2,63}$",
          "description": "An opaque private-session identifier, not private content or a local path."
        }
      }
    },
    "safety_privacy_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_raw_journal_content",
        "contains_selected_excerpts",
        "contains_therapy_or_crisis_notes",
        "contains_clinical_claims",
        "is_broad_trait_claim",
        "enough_evidence_for_durable_context",
        "exact_wording_and_destination_approved"
      ],
      "properties": {
        "contains_raw_journal_content": { "const": false },
        "contains_selected_excerpts": { "const": false },
        "contains_therapy_or_crisis_notes": { "const": false },
        "contains_clinical_claims": { "const": false },
        "is_broad_trait_claim": { "type": "boolean" },
        "enough_evidence_for_durable_context": { "type": "boolean" },
        "exact_wording_and_destination_approved": { "type": "boolean" }
      }
    },
    "approved_safety_privacy_checks": {
      "allOf": [
        { "$ref": "#/$defs/safety_privacy_checks" },
        {
          "properties": {
            "is_broad_trait_claim": { "const": false },
            "enough_evidence_for_durable_context": { "const": true },
            "exact_wording_and_destination_approved": { "const": true }
          }
        }
      ]
    }
  }
}
